+  else answer = { scope: "single", category: "regulation", tags: [], subjects: [], fact: null };
+  return { id: "test", choices: [{ message: { content: JSON.stringify(answer) } }], usage: { prompt_tokens: 10, completion_tokens: 10 } };
+});
