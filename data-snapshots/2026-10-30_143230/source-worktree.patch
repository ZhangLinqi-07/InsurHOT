+import { Link, useLoaderData, useSearchParams } from "react-router";
+import type { RadarResponse } from "@aihot/contracts/radar";
+import type { SiteStats } from "@aihot/contracts/site";
+import { apiGet, cachedPage } from "@aihot/web/lib/api.server";
+import { pageMeta } from "@aihot/web/lib/seo";
+import type { Screen } from "@aihot/web/components/shell/screens";
+import { NewsConstellation, NewsRiver } from "./radar-visuals.tsx";
+import { RadarArticle, RadarHeader, RadarScope, useRadarSelection } from "./radar-shared.tsx";
+
+export const handle: Screen = { tab: "me", name: "总览" };
+export { pageHeaders as headers } from "@aihot/web/lib/api.server";
+export { radarShouldRevalidate as shouldRevalidate } from "./radar-shared.tsx";
+
+export async function loader({ request }: { request: Request }) {
+  const [radar, stats] = await Promise.all([
+    apiGet<RadarResponse>("/api/site/insurance/radar?days=90", { signal: request.signal }),
+    apiGet<SiteStats>("/api/site/stats", { signal: request.signal }),
+  ]);
+  return cachedPage(0, { radar, stats });
+}
+
+export function meta() {
+  return pageMeta({ title: "总览", description: "浏览保险动态概况，联动查看信源、报道与主题。", path: "/overview" });
+}
+
+export default function InsuranceOverview() {
+  const { radar, stats } = useLoaderData<typeof loader>();
+  const [params] = useSearchParams();
+  const selection = useRadarSelection(radar.items, params.get("item"));
+  const activeId = selection.active?.id ?? null;
+  return <div className="pb-8">
+    <RadarHeader title="总览" description="从可信来源读懂保险行业的变化，联动查看报道与主题。" active="overview" query={activeId ? `?item=${encodeURIComponent(activeId)}` : ""} />
+    <section aria-label="站点概况" className="mb-5 grid grid-cols-2 gap-5 rounded-card border border-line bg-surface p-4 lg:grid-cols-4 lg:p-5">
+      {([["启用信源", stats.sources], ["收录动态", stats.items], ["精选报道", stats.selected], ["已出日报", stats.dailies]] as const).map(([label, value]) => <div key={label}><p className="text-[12px] text-ink-4">{label}</p><p className="num mt-1 text-[28px] font-bold leading-tight text-ink">{value.toLocaleString("en-US")}</p></div>)}
+    </section>
+    <section aria-label="报道扫描" className="mb-5">
+      <div className="mb-3 flex flex-wrap items-center justify-between gap-3"><h2 className="text-[16px] font-semibold text-ink">报道扫描</h2>{selection.controls}</div>
+      <div className="grid items-start gap-4 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
+        <RadarArticle item={selection.active} />
+        <div className="min-w-0 rounded-card border border-line bg-surface p-4"><h3 className="text-[14px] font-semibold text-ink">信源与主题星图</h3><NewsConstellation items={radar.items} activeId={activeId} onSelect={selection.select} /></div>
+      </div>
+    </section>
+    <section aria-label="新闻流" className="rounded-card border border-line bg-surface p-4 lg:p-5">
+      <div className="flex flex-wrap items-center justify-between gap-3"><h2 className="text-[16px] font-semibold text-ink">新闻流</h2><Link className="text-[13px] font-medium text-accent" to={`/radar${activeId ? `?item=${encodeURIComponent(activeId)}` : ""}`}>打开新闻雷达</Link></div>
+      <RadarScope data={radar} /><NewsRiver items={radar.items} activeId={activeId} onSelect={selection.select} />
+    </section>
+  </div>;
+}
